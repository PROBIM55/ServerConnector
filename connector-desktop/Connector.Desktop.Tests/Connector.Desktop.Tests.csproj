<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- C2b: вид-модель «Конвертера» и ConverterDispatch (Dispatcher) — WPF без окна. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the small unit under test directly so the test output does
         not copy the desktop application's bundled Git/VPN payload. -->
    <Compile Include="..\Connector.Desktop\Services\UpdateService.cs"
             Link="Services\UpdateService.cs" />
    <Compile Include="..\Connector.Desktop\Services\TcpConnectivityProbe.cs"
             Link="Services\TcpConnectivityProbe.cs" />
    <Compile Include="..\Connector.Desktop\Services\VpnConfigComparer.cs"
             Link="Services\VpnConfigComparer.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- C2b: вид-модель вкладки «Конвертер» без окна и без полезной нагрузки приложения. -->
    <ProjectReference Include="..\Connector.AgrConversion\Connector.AgrConversion.csproj" />
    <Compile Include="..\Connector.Desktop\Mvvm\ObservableObject.cs" Link="Mvvm\ObservableObject.cs" />
    <Compile Include="..\Connector.Desktop\Mvvm\RelayCommand.cs" Link="Mvvm\RelayCommand.cs" />
    <Compile Include="..\Connector.Desktop\Features\Converter\ConverterText.cs" Link="Converter\ConverterText.cs" />
    <Compile Include="..\Connector.Desktop\Features\Converter\ConverterRowViewModel.cs" Link="Converter\ConverterRowViewModel.cs" />
    <Compile Include="..\Connector.Desktop\Features\Converter\ConverterReportViewModel.cs" Link="Converter\ConverterReportViewModel.cs" />
    <Compile Include="..\Connector.Desktop\Features\Converter\ConverterViewModel.cs" Link="Converter\ConverterViewModel.cs" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

</Project>
