<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="GraphiteBackgroundColor">#12171D</Color><Color x:Key="GraphiteSurfaceColor">#1A2027</Color><Color x:Key="GraphiteSubtleColor">#252E38</Color><Color x:Key="GraphiteTextColor">#EDF2F6</Color><Color x:Key="GraphiteMutedColor">#AEB9C4</Color><Color x:Key="GraphiteLineColor">#394652</Color><Color x:Key="GraphiteAccentColor">#77B8DD</Color>
  <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource GraphiteBackgroundColor}" /><SolidColorBrush x:Key="PanelBorder" Color="{StaticResource GraphiteLineColor}" /><SolidColorBrush x:Key="TabActiveBrush" Color="{StaticResource GraphiteAccentColor}" /><SolidColorBrush x:Key="GraphiteSurfaceBrush" Color="{StaticResource GraphiteSurfaceColor}" /><SolidColorBrush x:Key="GraphiteSubtleBrush" Color="{StaticResource GraphiteSubtleColor}" /><SolidColorBrush x:Key="GraphiteTextBrush" Color="{StaticResource GraphiteTextColor}" /><SolidColorBrush x:Key="GraphiteMutedBrush" Color="{StaticResource GraphiteMutedColor}" /><SolidColorBrush x:Key="GraphiteAccentBrush" Color="{StaticResource GraphiteAccentColor}" />
  <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource GraphiteSurfaceBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="3" /><Setter Property="Padding" Value="18" /></Style>
  <Style x:Key="BaseButton" TargetType="Button"><Setter Property="Foreground" Value="{StaticResource GraphiteTextBrush}" /><Setter Property="Background" Value="{StaticResource GraphiteSubtleBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="11,8" /><Setter Property="MinHeight" Value="36" /><Setter Property="FontFamily" Value="Segoe UI Variable Text" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Margin" Value="0,0,8,8" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{StaticResource GraphiteAccentBrush}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonRoot" Property="Opacity" Value="0.82" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonRoot" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="Foreground" Value="#0D1D27" /><Setter Property="Background" Value="{StaticResource GraphiteAccentBrush}" /><Setter Property="BorderBrush" Value="{StaticResource GraphiteAccentBrush}" /></Style><Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}" /><Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="Foreground" Value="#EF9B96" /><Setter Property="BorderBrush" Value="#83464A" /><Setter Property="Background" Value="#261B20" /></Style><Style x:Key="SyncButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}" /><Style x:Key="PublishButton" TargetType="Button" BasedOn="{StaticResource BaseButton}"><Setter Property="Foreground" Value="#E4BB5D" /><Setter Property="BorderBrush" Value="#7A6333" /></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource GraphiteTextBrush}" /><Setter Property="FontFamily" Value="Segoe UI Variable Text" /></Style><Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource GraphiteMutedBrush}" /><Setter Property="FontFamily" Value="Segoe UI Variable Text" /></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource GraphiteTextBrush}" /><Setter Property="Background" Value="#11171E" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="9,7" /><Setter Property="FontFamily" Value="Segoe UI Variable Text" /></Style><Style TargetType="PasswordBox"><Setter Property="Foreground" Value="{StaticResource GraphiteTextBrush}" /><Setter Property="Background" Value="#11171E" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="9,7" /><Setter Property="FontFamily" Value="Segoe UI Variable Text" /></Style><Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource GraphiteTextBrush}" /><Setter Property="FontFamily" Value="Segoe UI Variable Text" /></Style>
  <Style x:Key="ProductModeButton" TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource GraphiteMutedBrush}" /><Setter Property="FontFamily" Value="Segoe UI Variable Text" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="ModeBorder" Padding="8,11" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ModeBorder" Property="Background" Value="{StaticResource GraphiteSubtleBrush}" /><Setter TargetName="ModeBorder" Property="BorderBrush" Value="{StaticResource GraphiteAccentBrush}" /><Setter Property="Foreground" Value="{StaticResource GraphiteTextBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeBorder" Property="Background" Value="#2D3742" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="NavigationTabs" TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="184" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{StaticResource GraphiteSurfaceBrush}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0" Padding="8,14"><TabPanel IsItemsHost="True" /></Border><ContentPresenter Grid.Column="2" ContentSource="SelectedContent" /></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="NavigationTabItem" TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource GraphiteMutedBrush}" /><Setter Property="FontFamily" Value="Segoe UI Variable Text" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,1" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="ItemBorder" Padding="11,10" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0"><ContentPresenter VerticalAlignment="Center" ContentSource="Header" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource GraphiteSubtleBrush}" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource GraphiteAccentBrush}" /><Setter Property="Foreground" Value="{StaticResource GraphiteTextBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#222B35" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ModuleTabs" TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Margin="0,0,0,16"><TabPanel IsItemsHost="True" /></Border><ContentPresenter Grid.Row="1" ContentSource="SelectedContent" /></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ModuleTabItem" TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource GraphiteMutedBrush}" /><Setter Property="FontFamily" Value="Segoe UI Variable Text" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="8,8" Margin="0,0,12,0" BorderBrush="Transparent" BorderThickness="0,0,0,2"><ContentPresenter ContentSource="Header" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource GraphiteAccentBrush}" /><Setter Property="Foreground" Value="{StaticResource GraphiteTextBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ContentTabs" TargetType="TabControl">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent" /></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NavigationList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource GraphiteTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,2" /><Setter Property="Padding" Value="12,11" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Item" Background="Transparent" BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource GraphiteSubtleBrush}" /><Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource GraphiteAccentBrush}" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#222B35" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource GraphiteTextBrush}" />
    <Setter Property="Background" Value="#11171E" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="10,8" /><Setter Property="MinHeight" Value="36" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,8,32,8" IsHitTestVisible="False" />
        <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" Background="Transparent">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource GraphiteMutedBrush}" /></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
          <Border Background="{StaticResource GraphiteSurfaceBrush}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer><ItemsPresenter /></ScrollViewer></Border>
        </Popup>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource GraphiteTextBrush}" /><Setter Property="Padding" Value="10,8" /><Setter Property="Background" Value="{StaticResource GraphiteSurfaceBrush}" /></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="{StaticResource GraphiteSurfaceBrush}" /><Setter Property="Foreground" Value="{StaticResource GraphiteTextBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /><Setter Property="BorderThickness" Value="0" /></Style>
</ResourceDictionary>
