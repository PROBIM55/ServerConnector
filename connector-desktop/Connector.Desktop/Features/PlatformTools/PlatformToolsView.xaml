<UserControl x:Class="Connector.Desktop.Features.PlatformTools.PlatformToolsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,10,12,12"><TextBlock Text="Инструменты Платформы" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Проверки запускаются только по кнопке и не открывают CAD-приложения." Foreground="{StaticResource GraphiteMutedBrush}" Margin="0,4,0,18"/>
  <TabControl Style="{StaticResource ModuleTabs}"><TabControl.ItemContainerStyle><Style TargetType="TabItem" BasedOn="{StaticResource ModuleTabItem}"/></TabControl.ItemContainerStyle>
   <TabItem Header="АГР"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Blender для АГР" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Локальная готовность Blender и рабочего модуля АГР." Foreground="{StaticResource GraphiteMutedBrush}" Margin="0,5,0,12"/><TextBlock Text="{Binding AgrStatus}" TextWrapping="Wrap"/><WrapPanel Margin="0,14,0,0"><Button Style="{StaticResource SecondaryButton}" Content="Проверить" Command="{Binding ProbeAgrCommand}"/><Button Style="{StaticResource PrimaryButton}" Content="Установить Blender" Command="{Binding InstallAgrCommand}"/></WrapPanel></StackPanel></Border></TabItem>
   <TabItem Header="Tekla"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Связь с Tekla" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Проверяется доступность уже запущенного Bridge.Desktop; Tekla не запускается." Foreground="{StaticResource GraphiteMutedBrush}" Margin="0,5,0,12"/><TextBlock Text="{Binding TeklaStatus}" TextWrapping="Wrap"/><Button Style="{StaticResource SecondaryButton}" Content="Проверить связь" Command="{Binding ProbeTeklaCommand}" Margin="0,14,0,0"/></StackPanel></Border></TabItem>
   <TabItem Header="AutoCAD"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Сеансы AutoCAD" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Проверяется список уже запущенных сеансов AutoCAD через системный реестр COM." Foreground="{StaticResource GraphiteMutedBrush}" Margin="0,5,0,12"/><TextBlock Text="{Binding AutoCadStatus}" TextWrapping="Wrap"/><Button Style="{StaticResource SecondaryButton}" Content="Проверить сеансы" Command="{Binding ProbeAutoCadCommand}" Margin="0,14,0,0"/></StackPanel></Border></TabItem>
  </TabControl></StackPanel></ScrollViewer>
</UserControl>
