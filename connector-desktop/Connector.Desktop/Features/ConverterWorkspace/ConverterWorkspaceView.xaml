<UserControl x:Class="Connector.Desktop.Features.ConverterWorkspace.ConverterWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,10,12,12"><TextBlock Text="Конвертеры" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Выберите инструмент, исходные данные и папку результата." Foreground="{StaticResource GraphiteMutedBrush}" Margin="0,4,0,18"/>
  <ListBox Style="{StaticResource NavigationList}" SelectedIndex="{Binding SelectedIndex, ElementName=ConverterForms, Mode=TwoWay}" Margin="0,0,0,16"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBoxItem><StackPanel Width="240"><TextBlock Text="АГР → GLB" FontWeight="SemiBold"/><TextBlock Text="FBX-части АГР для просмотра в Студии" FontSize="11" Foreground="{StaticResource GraphiteMutedBrush}" Margin="0,5,0,0"/></StackPanel></ListBoxItem><ListBoxItem><StackPanel Width="240"><TextBlock Text="Оптимизация IFC" FontWeight="SemiBold"/><TextBlock Text="Уменьшение модели с проверкой результата" FontSize="11" Foreground="{StaticResource GraphiteMutedBrush}" Margin="0,5,0,0"/></StackPanel></ListBoxItem></ListBox><TabControl x:Name="ConverterForms" Style="{StaticResource ContentTabs}"><TabControl.ItemContainerStyle><Style TargetType="TabItem" BasedOn="{StaticResource ModuleTabItem}"/></TabControl.ItemContainerStyle>
   <TabItem Header="FBX → GLB"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Модели АГР / FBX" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Архив или папка одной части АГР" Margin="0,12,0,3"/><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Выбрать ZIP" Command="{Binding PickFbxInputCommand}"/><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Папка части" Command="{Binding PickFbxFolderCommand}"/><TextBox Text="{Binding FbxInputPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Text="Папка результата" Margin="0,10,0,3"/><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Выбрать папку" Command="{Binding PickOutputCommand}"/><TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><Button Style="{StaticResource PrimaryButton}" Content="Конвертировать в GLB" Command="{Binding SubmitFbxCommand}" Margin="0,14,0,0"/></StackPanel></Border></TabItem>
   <TabItem Header="Оптимизация IFC"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Оптимизация IFC" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="IFC-файл" Margin="0,12,0,3"/><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Выбрать IFC" Command="{Binding PickIfcInputCommand}"/><TextBox Text="{Binding IfcInputPath, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Text="Папка результата" Margin="0,10,0,3"/><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Выбрать папку" Command="{Binding PickOutputCommand}"/><TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><TextBlock Text="Профиль" Margin="0,10,0,3"/><ComboBox SelectedValue="{Binding IfcProfile}" SelectedValuePath="Tag"><ComboBoxItem Tag="exact" Content="Точное сохранение геометрии"/><ComboBoxItem Tag="compact" Content="Компактный результат"/></ComboBox><Button Style="{StaticResource PrimaryButton}" Content="Оптимизировать IFC" Command="{Binding SubmitIfcCommand}" Margin="0,14,0,0"/></StackPanel></Border></TabItem>
  </TabControl>
  <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Отменить" Command="{Binding CancelCommand}"/><TextBlock Text="Задания и результаты" FontSize="17" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Message}" Foreground="{StaticResource GraphiteMutedBrush}" Margin="0,5,0,10"/><ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}"/><TextBlock Grid.Column="1" Text="{Binding State}"/><TextBlock Grid.Column="2" Text="{Binding Progress}"/><TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource SecondaryButton}" Content="Открыть результат" Command="{Binding OpenResultCommand}"/><Button Style="{StaticResource SecondaryButton}" Content="Открыть отчёт" Command="{Binding OpenReportCommand}"/></WrapPanel></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
