<UserControl x:Class="Connector.Desktop.Features.GraphiteWeb.GraphiteWebView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:webview="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#12171D">
    <Grid Background="#12171D">
        <webview:WebView2 x:Name="Browser" />

        <Border x:Name="InitializationError"
                Visibility="Collapsed"
                Background="#12171D"
                Padding="28">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420">
                <TextBlock Text="Не удалось открыть интерфейс Connector"
                           Foreground="#EDF2F6"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock x:Name="InitializationErrorText"
                           Margin="0,10,0,0"
                           Foreground="#AEB9C4"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
