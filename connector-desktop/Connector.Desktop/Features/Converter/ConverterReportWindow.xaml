<Window x:Class="Connector.Desktop.Features.Converter.ConverterReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Connector.Desktop.Features.Converter"
        Title="{Binding WindowTitle}"
        Width="800"
        SizeToContent="Height"
        MaxHeight="900"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="#090E15">
    <!-- Окно «Отчёт — <часть>» (C2b, макет C2 кадр 4) по образцу ReleaseNotesWindow: та же панель, заголовок, мета и
         маркеры. DataContext — ConverterReportViewModel. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
        <SolidColorBrush x:Key="ReportPanel" Color="#101823" />
        <SolidColorBrush x:Key="ReportPanelBorder" Color="#2A3E5C" />
        <SolidColorBrush x:Key="MutedText" Color="#94AACC" />
        <SolidColorBrush x:Key="MainText" Color="#EDF4FF" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MainText}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDF4FF" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="HeadCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="#92A5C3" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EDF4FF" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>
        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource ConverterTableRowDivider}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="MinHeight" Value="31" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Bullet">
            <Grid Margin="0,0,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="•" Foreground="#8EC8FF" FontSize="16" Margin="0,-3,0,0" />
                <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Margin="0" Text="{Binding}" TextWrapping="Wrap" TextTrimming="None" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="WarnBullet">
            <Grid Margin="0,0,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="•" Foreground="#FFA500" FontSize="16" Margin="0,-3,0,0" />
                <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Margin="0" Text="{Binding}" TextWrapping="Wrap" TextTrimming="None" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource ReportPanel}" BorderBrush="{StaticResource ReportPanelBorder}" BorderThickness="1"
                CornerRadius="14" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Meta}" Foreground="{StaticResource MutedText}" FontSize="13" Margin="0,6,0,14" TextWrapping="Wrap" />

                    <!-- Ошибка: этап и текст. -->
                    <StackPanel Visibility="{Binding IsFailure, Converter={StaticResource Vis}}">
                        <TextBlock Style="{StaticResource Section}" Margin="0,0,0,8" Text="Ошибка" />
                        <TextBlock Text="{Binding ErrorStage}" Foreground="{StaticResource MutedText}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding ErrorText}" Foreground="#FFA500" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Готовая часть: уровни, текстуры, предупреждения. -->
                    <StackPanel Visibility="{Binding IsPart, Converter={StaticResource Vis}}">
                        <TextBlock Style="{StaticResource Section}" Margin="0,0,0,8" Text="Треугольники и уровни детализации" />
                        <Border Background="{StaticResource ConverterTableBackground}" BorderBrush="{StaticResource ConverterTableBorder}"
                                BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True">
                            <StackPanel>
                                <Border Background="{StaticResource ConverterTableHeaderBackground}" BorderBrush="{StaticResource ConverterTableBorder}"
                                        BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Height="28">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="98" />
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource HeadCell}" Text="Уровень" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource HeadCell}" Text="Треугольники" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource HeadCell}" Text="Доля" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource HeadCell}" Text="Текстуры" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource HeadCell}" Text="Размер" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource HeadCell}" Text="Точность упрощения" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Levels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type conv:ConverterReportLevelRow}">
                                            <Border Style="{StaticResource TableRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="128" />
                                                        <ColumnDefinition Width="98" />
                                                        <ColumnDefinition Width="54" />
                                                        <ColumnDefinition Width="82" />
                                                        <ColumnDefinition Width="78" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{StaticResource Cell}" Text="{Binding Level}" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding Triangles}" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding Share}" />
                                                    <TextBlock Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding Textures}" />
                                                    <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding Size}" />
                                                    <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Text="{Binding Accuracy}"
                                                               Foreground="{Binding AccuracyColor}" TextWrapping="Wrap" TextTrimming="None" Margin="8,4" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Section}" Text="Текстуры" />
                        <ItemsControl ItemsSource="{Binding Textures}" ItemTemplate="{StaticResource Bullet}" />
                        <TextBlock Style="{StaticResource Section}" Text="Предупреждения" />
                        <ItemsControl ItemsSource="{Binding Warnings}" ItemTemplate="{StaticResource WarnBullet}" />
                        <TextBlock Text="Нет." Foreground="{StaticResource MutedText}" Visibility="{Binding NoWarnings, Converter={StaticResource Vis}}" />
                    </StackPanel>

                    <!-- Запуск из истории: части с итогом и отчётом каждой. -->
                    <StackPanel Visibility="{Binding IsRun, Converter={StaticResource Vis}}">
                        <TextBlock Style="{StaticResource Section}" Margin="0,0,0,8" Text="Части" />
                        <Border Background="{StaticResource ConverterTableBackground}" BorderBrush="{StaticResource ConverterTableBorder}"
                                BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True">
                            <ItemsControl ItemsSource="{Binding Parts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type conv:ConverterReportPartRow}">
                                        <Border Style="{StaticResource TableRow}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource ConverterRowButton}" Content="Отчёт"
                                                        Margin="6,0,8,0" VerticalAlignment="Center" Command="{Binding ReportCommand}" />
                                                <TextBlock Style="{StaticResource Cell}" Width="200" Text="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Cell}" Text="{Binding Outcome}" Foreground="{Binding OutcomeColor}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Section}" Text="Файлы" />
                    <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type conv:ConverterReportFile}">
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Cell}" Margin="0" Foreground="#94AACC" Text="{Binding Key}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Margin="0" Text="{Binding Value}"
                                               TextWrapping="Wrap" TextTrimming="None" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="Скопировать отчёт" Command="{Binding CopyCommand}" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="Открыть папку" Command="{Binding OpenFolderCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="Закрыть" IsDefault="True" IsCancel="True" x:Name="CloseButton" />
        </StackPanel>
    </Grid>
</Window>
