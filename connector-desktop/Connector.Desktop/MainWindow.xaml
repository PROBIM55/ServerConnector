<Window x:Class="Connector.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:graphite="clr-namespace:Connector.Desktop.Features.GraphiteWeb"
        Title="Connector" Height="900" Width="1180" MinHeight="720" MinWidth="920"
        Background="#12171D" Loaded="Window_Loaded">
    <Grid Background="#12171D">
        <graphite:GraphiteWebView x:Name="GraphiteWebHost" />
        <!-- Existing feature controls retain their settings/commands during the renderer migration.
             The approved HTML/CSS is the only visible product interface. -->
        <Grid Visibility="Collapsed">
            <TabControl x:Name="MainTabs">
                <TabItem><ContentControl x:Name="ConnectorHost" /></TabItem>
                <TabItem><ContentControl x:Name="StructuraHost" /></TabItem>
                <TabItem><TabControl x:Name="TeklaTabs" /></TabItem>
                <TabItem><ContentControl x:Name="AttributesHost" /></TabItem>
                <TabItem><ContentControl x:Name="VpnHost" /></TabItem>
                <TabItem><TabControl x:Name="ConverterTabs" /></TabItem>
            </TabControl>
            <ContentControl x:Name="PlatformHost" />
            <ContentControl x:Name="ConverterWorkspaceHost" />
            <ContentControl x:Name="PlatformToolsHost" />
            <TextBlock x:Name="HeaderServerStatusTextBlock" />
            <TextBlock x:Name="HeaderFirmStatusTextBlock" />
            <TextBox x:Name="LogTextBox" />
        </Grid>
    </Grid>
</Window>