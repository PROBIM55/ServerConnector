<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle Name="Платформа Коннектор"
          Manufacturer="Structura"
          Version="$(var.ProductVersion)"
          UpgradeCode="DC40328B-3AD1-4F4C-8A34-9A876DA14E23"
          IconSourceFile="$(sys.SOURCEFILEDIR)..\Connector.Desktop\Assets\platform_connector.ico"
          Compressed="yes">
    <BootstrapperApplication>
      <Payload Name="platform_connector.ico"
               SourceFile="$(sys.SOURCEFILEDIR)..\Connector.Desktop\Assets\platform_connector.ico" />
      <!-- The hyperlink payload group supplies WixStdbaInformation even with a custom theme. -->
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl=""
          ThemeFile="$(sys.SOURCEFILEDIR)InstallerTheme.xml"
          LocalizationFile="$(sys.SOURCEFILEDIR)Installer.ru-ru.wxl"
          LogoFile="$(sys.SOURCEFILEDIR)..\Connector.Desktop\Assets\platform_installer_logo.png"
          SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <Variable Name="WebView2MachineVersion" Type="version" Value="0.0.0.0" />
    <Variable Name="WebView2UserVersion" Type="version" Value="0.0.0.0" />
    <Variable Name="NetBirdInstalledVersion" Type="version" Value="0.0.0.0" />
    <Variable Name="NetBirdServicePresent" Type="numeric" Value="0" />
    <Variable Name="NetBirdCliPresent" Type="numeric" Value="0" />
    <Variable Name="NetBirdDataPresent" Type="numeric" Value="0" />
    <util:RegistrySearch Id="NetBirdServiceSearch" Root="HKLM" Bitness="always64"
        Key="SYSTEM\CurrentControlSet\Services\NetBird" Result="exists" Variable="NetBirdServicePresent" />
    <util:FileSearch Id="NetBirdCliSearch" Path="[ProgramFiles64Folder]NetBird\netbird.exe"
        Result="exists" Variable="NetBirdCliPresent" />
    <util:DirectorySearch Id="NetBirdDataSearch" Path="[CommonAppDataFolder]NetBird"
        Result="exists" Variable="NetBirdDataPresent" />
    <util:ProductSearch Id="NetBirdVersionSearch" UpgradeCode="$(var.NetBirdUpgradeCode)"
        Result="version" Variable="NetBirdInstalledVersion" />
    <util:RegistrySearch Id="WebView2MachineSearch" Root="HKLM" Bitness="always32"
        Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Value="pv" Variable="WebView2MachineVersion" />
    <util:RegistrySearch Id="WebView2UserSearch" Root="HKCU" Bitness="always32"
        Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
        Value="pv" Variable="WebView2UserVersion" />

    <!-- Machine MSI has its own transaction; user migration owns its recovery.
         A later user-stage failure must not reinstall failed related bundles. -->
    <Chain DisableRollback="yes" DisableSystemRestore="yes">
      <!-- Shared prerequisites are retained on connector removal. No token, server
           access, Blender download or optional-user action gates these packages. -->
      <ExePackage Id="WebView2Runtime" DisplayName="Компонент интерфейса Microsoft WebView2"
                  SourceFile="$(var.WebView2Installer)" InstallArguments="/silent /install"
                  DetectCondition="WebView2MachineVersion &gt; v0.0.0.0 OR WebView2UserVersion &gt; v0.0.0.0"
                  PerMachine="yes" Permanent="yes" Vital="yes" Compressed="yes" />
      <MsiPackage Id="NetBirdRuntime" DisplayName="Защищённое подключение NetBird"
                  SourceFile="$(var.NetBirdMsi)" Permanent="yes" Vital="yes" Visible="no"
                  InstallCondition="NetBirdInstalledVersion &lt;= v0.79.0">
        <MsiProperty Name="MSIFASTINSTALL" Value="1" />
      </MsiPackage>

      <MsiPackage Id="UnifiedMachineSetup"
                  DisplayName="Компоненты Платформа Коннектор"
                  SourceFile="$(var.UnifiedSetupMsi)"
                  Vital="yes"
                  Visible="no">
        <MsiProperty Name="MSIFASTINSTALL" Value="1" />
        <!-- These are detection-time values, before the NetBird package runs.
             An existing installation or orphaned state must never be claimed. -->
        <MsiProperty Name="STRUCTURA_NETBIRD_PRIOR_VERSION" Value="[NetBirdInstalledVersion]" />
        <MsiProperty Name="STRUCTURA_NETBIRD_PRIOR_SERVICE" Value="[NetBirdServicePresent]" />
        <MsiProperty Name="STRUCTURA_NETBIRD_PRIOR_CLI" Value="[NetBirdCliPresent]" />
        <MsiProperty Name="STRUCTURA_NETBIRD_PRIOR_DATA" Value="[NetBirdDataPresent]" />
      </MsiPackage>

      <!-- Once staging is committed, a per-user migration failure must never roll it back. -->
      <RollbackBoundary Id="UnifiedMachineSetupCommitted" />

      <!-- Burn's default per-user execution impersonates the initiating user even when the
           machine MSI required elevation. The bridge has no arguments or uninstall action. -->
      <ExePackage Id="OriginalUserUpgradeBridge"
                  DisplayName="Приложение Платформа Коннектор и ярлыки"
                  Name="Connector.Upgrade.LaunchBridge.exe"
                  SourceFile="$(var.LaunchBridge)"
                  DetectCondition="0"
                  PerMachine="no"
                  Permanent="yes"
                  Vital="yes"
                  Compressed="yes">
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>
    </Chain>
  </Bundle>
</Wix>
