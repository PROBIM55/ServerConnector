<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>Structura.Connector.Installer</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);UnifiedSetupMsi=$(UnifiedSetupMsiPath);LaunchBridge=$(LaunchBridgePath);NetBirdMsi=$(NetBirdMsiPath);NetBirdUpgradeCode=$(NetBirdUpgradeCode);WebView2Installer=$(WebView2InstallerPath)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>

  <Target Name="ValidateUnifiedBundleInputs" BeforeTargets="Build">
    <Error Condition="'$(ProductVersion)' == ''" Text="ProductVersion must be supplied as a three-part numeric version." />
    <Error Condition="'$(UnifiedSetupMsiPath)' == '' or !Exists('$(UnifiedSetupMsiPath)')" Text="UnifiedSetupMsiPath must point to the built Connector.Unified.Setup.msi." />
    <Error Condition="'$(LaunchBridgePath)' == '' or !Exists('$(LaunchBridgePath)')" Text="LaunchBridgePath must point to the published Connector.Upgrade.LaunchBridge.exe." />
    <Error Condition="'$(NetBirdMsiPath)' == '' or !Exists('$(NetBirdMsiPath)')" Text="The official pinned NetBird MSI is required." />
    <Error Condition="'$(NetBirdUpgradeCode)' == ''" Text="The official NetBird MSI upgrade identity is required." />
    <Error Condition="'$(WebView2InstallerPath)' == '' or !Exists('$(WebView2InstallerPath)')" Text="The verified Microsoft WebView2 standalone installer is required." />
  </Target>
</Project>
