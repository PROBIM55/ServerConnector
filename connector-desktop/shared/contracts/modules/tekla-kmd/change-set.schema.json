{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structura-most.ru/contracts/tekla-kmd/change-set.schema.json",
  "title": "Tekla KMD change set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "expectedTeklaVersion", "workspaceId", "baseGenerationId", "correlationId", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "expectedTeklaVersion": { "const": "2020" },
    "workspaceId": { "type": "string", "minLength": 1 },
    "baseGenerationId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemNo", "operation", "objectType", "payload"],
        "properties": {
          "itemNo": { "type": "integer", "minimum": 1 },
          "operation": { "enum": ["create", "modify", "delete", "component-upsert", "component-delete"] },
          "objectGuid": { "type": "string" },
          "objectType": { "type": "string", "minLength": 1 },
          "payload": { "type": "object" }
        }
      }
    }
  }
}
