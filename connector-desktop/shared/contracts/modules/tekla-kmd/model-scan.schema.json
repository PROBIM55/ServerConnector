{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structura-most.ru/contracts/tekla-kmd/model-scan.schema.json",
  "title": "Tekla KMD model scan request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "expectedTeklaVersion", "workspaceId", "correlationId", "scope"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "expectedTeklaVersion": { "const": "2020" },
    "workspaceId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "scope": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "model" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "selection" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "objectGuids"],
          "properties": {
            "kind": { "const": "objects" },
            "objectGuids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "includeTopology": { "type": "boolean", "default": true },
    "includeRenderMesh": { "type": "boolean", "default": true },
    "chunkSize": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 }
  }
}
