<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType><InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>ProductVersion=$(ProductVersion);DesktopDir=$(DesktopPublishDir);AccessConfiguration=$(ConnectorAccessConfigurationPath);NetBirdMsi=$(NetBirdMsiPath);NetBirdPreflight=$(NetBirdPreflightScriptPath);NetBirdVerifier=$(NetBirdVerifierScriptPath);NetBirdLock=$(NetBirdIdentityLockPath)</DefineConstants>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" /></ItemGroup>
</Project>
