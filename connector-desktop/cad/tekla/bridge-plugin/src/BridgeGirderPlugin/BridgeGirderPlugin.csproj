<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <!--
      Output filename MUST be BridgeGirderPlugin.dll: Tekla resolves the
      .inp page → plugin name → DLL filename via exact match in the
      Extensions\BridgeComponent folder. Project name and namespace can
      differ; assembly name must not.
    -->
    <!--
      AssemblyName=Bridge.TeklaPlugin (НЕ BridgeGirderPlugin) — точное
      зеркало прежнего плагина (.bak-20260311-064255). Tekla при resolve
      может полагаться на assembly identity. Output получает имя
      Bridge.TeklaPlugin.dll; post-build (или redeploy_plugin.ps1)
      копирует его как BridgeGirderPlugin.dll AND BridgeMvpPlugin.dll
      в Tekla Extensions (как делал прежний deploy — байт-идентичные копии,
      см. cmp на .bak-20260311 → IDENTICAL).
    -->
    <AssemblyName>Bridge.TeklaPlugin</AssemblyName>
    <RootNamespace>Bridge.TeklaPlugin</RootNamespace>
    <TeklaBin Condition="'$(TeklaBin)' == ''">C:\TeklaStructures\2025.0\bin</TeklaBin>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Только TeklaBridge.exe в зависимостях — туда теперь скомпилирован весь
      Platform.Bridge.Geometry source (см. TeklaBridge.csproj). Private=false
      т.к. TeklaBridge.exe деплоится отдельно.
    -->
    <ProjectReference Include="..\TeklaBridge\TeklaBridge.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Tekla.Structures">
      <HintPath>$(TeklaBin)\Tekla.Structures.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tekla.Structures.Model">
      <HintPath>$(TeklaBin)\Tekla.Structures.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tekla.Structures.Plugins">
      <HintPath>$(TeklaBin)\Tekla.Structures.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
