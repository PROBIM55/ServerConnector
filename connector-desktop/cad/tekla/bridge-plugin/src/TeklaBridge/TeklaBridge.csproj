<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>TeklaBridge</AssemblyName>
    <RootNamespace>TeklaBridge</RootNamespace>
    <!--
      Mirrors the original architecture: TeklaBridge.exe is both a CLI tool
      (Program.Main dispatches command.txt → result.txt) AND a class library
      consumed by both BridgeGirderPlugin.dll and BridgeMvpPlugin.dll via
      ProjectReference. BridgeCommands.CreateGirderStep4/5 live here.
    -->
    <TeklaBin Condition="'$(TeklaBin)' == ''">C:\TeklaStructures\2025.0\bin</TeklaBin>
  </PropertyGroup>

  <!--
    Platform.Bridge.Geometry source files (из shared/bridge-geometry/) компилируются
    ВНУТРЬ TeklaBridge.exe напрямую (Compile Include), а не через ProjectReference.
    Причина: при отдельной Platform.Bridge.Geometry.dll в Tekla extensions folder,
    plugin-AppDomain не всегда находит транзитивные сборки. Слияние в одну
    TeklaBridge.exe устраняет точку отказа.

    shared/bridge-geometry — единственный источник правды для pure-логики;
    её отдельная сборка существует для xUnit-тестов (там Tekla SDK не нужен).
  -->
  <ItemGroup>
    <Compile Include="..\..\..\..\..\shared\bridge-geometry\src\**\*.cs"
             Exclude="..\..\..\..\..\shared\bridge-geometry\src\obj\**\*.cs;..\..\..\..\..\shared\bridge-geometry\src\bin\**\*.cs"
             LinkBase="_BridgeGeometry" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Tekla.Structures">
      <HintPath>$(TeklaBin)\Tekla.Structures.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tekla.Structures.Model">
      <HintPath>$(TeklaBin)\Tekla.Structures.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tekla.Common.Geometry">
      <HintPath>$(TeklaBin)\Tekla.Common.Geometry.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tekla.Common.Geometry.Primitives">
      <HintPath>$(TeklaBin)\Tekla.Common.Geometry.Primitives.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tekla.Structures.Geometry3d.Compatibility">
      <HintPath>$(TeklaBin)\Tekla.Structures.Geometry3d.Compatibility.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
