<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FachwerkColumnPlugin</AssemblyName>
    <RootNamespace>Structura.Tekla.Fachwerk</RootNamespace>
    <TeklaBin Condition="'$(TeklaBin)' == ''">C:\TeklaStructures\2020.0\nt\bin\plugins</TeklaBin>
    <TeklaDialogsBin Condition="'$(TeklaDialogsBin)' == ''">C:\TeklaStructures\2020.0\nt\bin\dialogs</TeklaDialogsBin>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Tekla.Structures">
      <HintPath>$(TeklaBin)\Tekla.Structures.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tekla.Structures.Model">
      <HintPath>$(TeklaBin)\Tekla.Structures.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tekla.Structures.Plugins">
      <HintPath>$(TeklaBin)\Tekla.Structures.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tekla.Structures.Dialog">
      <HintPath>$(TeklaDialogsBin)\Tekla.Structures.Dialog.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\FachwerkRigelPlugin\FachwerkRigelCatalog.cs" Link="Rigel\FachwerkRigelCatalog.cs" />
    <Compile Include="..\FachwerkRigelPlugin\FachwerkRigelClearanceVisualization.cs" Link="Rigel\FachwerkRigelClearanceVisualization.cs" />
    <Compile Include="..\FachwerkRigelPlugin\FachwerkRigelGeometry.cs" Link="Rigel\FachwerkRigelGeometry.cs" />
    <Compile Include="..\FachwerkRigelPlugin\FachwerkRigelPlugin.cs" Link="Rigel\FachwerkRigelPlugin.cs" />
    <Compile Include="..\FachwerkRigelPlugin\FachwerkRigelPluginData.cs" Link="Rigel\FachwerkRigelPluginData.cs" />
    <Compile Include="..\FachwerkRigelPlugin\FachwerkRigelVisualization.cs" Link="Rigel\FachwerkRigelVisualization.cs" />
    <EmbeddedResource Include="..\..\deploy\component\FachwerkRigelCatalog.json">
      <LogicalName>Structura.Tekla.Fachwerk.FachwerkRigelCatalog.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
