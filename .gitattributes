# Full upstream license texts are shipped byte-for-byte on every checkout.
connector-desktop/Connector.Desktop/ThirdPartyLicenses/** -text

# These files are checked against byte-level SHA-256 release trust pins.
connector-desktop/scripts/netbird_windows_preflight.ps1 -text
connector-desktop/scripts/verify_netbird_installer.ps1 -text
connector-desktop/infra/netbird/v0.79.0-windows-x64.lock.json -text
connector-desktop/scripts/resource-guard/platform-build-guard.cs -text

# Approved desktop design resources retain LF bytes across Windows checkouts.
connector-desktop/design/*.html text eol=lf
connector-desktop/design/*.js text eol=lf
connector-desktop/design/*.css text eol=lf
connector-desktop/design/tests/*.cjs text eol=lf

# Binary design assets are release-pinned byte-for-byte.
connector-desktop/design/brand/platform-field-refined-v3.png -text
connector-desktop/design/fonts/** -text
